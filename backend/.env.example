SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-chave-publicavel-do-supabase
PORT=3000
NODE_ENV=development

# Origens do frontend autorizadas a chamar a API, separadas por vírgula.
# OBRIGATÓRIO em produção (NODE_ENV=production): o servidor não sobe sem isto.
# Em desenvolvimento, localhost:5173 e localhost:8080 já são aceitos automaticamente.
# Exemplo: CORS_ORIGINS=https://meu-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# Quantidade de proxies reversos entre o cliente e o Express em produção.
# Atrás de um único proxy/plataforma (Render, Railway...), mantenha 1.
# Sem proxy nenhum (ex.: docker compose local), use 0.
TRUST_PROXY_HOPS=1
