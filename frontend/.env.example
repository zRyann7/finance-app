# Copie para .env (desenvolvimento local). O Vite lê VITE_* em tempo de build.
# Endereço da API SEM o sufixo /api (o código acrescenta). Com /api no fim também funciona.
# No Docker, use --build-arg VITE_API_URL=... (o .env não entra na imagem).
VITE_API_URL=http://localhost:3000

# Supabase (somente o upload de foto de perfil usa o Supabase direto do navegador).
# Use a chave pública (anon/publishable), nunca a service_role.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publicavel-do-supabase
